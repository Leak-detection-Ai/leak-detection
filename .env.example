APP_ENV=development
APP_NAME=LeakGuard
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://leakguard:leakguard@localhost:5432/leakguard

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
CSRF_SECRET=replace-with-another-long-random-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=5
SOCIAL_SYNC_INTERVAL_SECONDS=60

# Optional OpenAI explanation layer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Mastodon
MASTODON_INSTANCE=https://mastodon.social
MASTODON_CLIENT_NAME=LeakGuard
MASTODON_CLIENT_WEBSITE=http://localhost:5173
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_REDIRECT_URI=http://localhost:8000/api/oauth/mastodon/callback
MASTODON_SCOPES=read:accounts read:statuses

# OCR
# Install the Tesseract binary separately and make sure "tesseract" is on PATH.

SEED_DEMO=false
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=ChangeThisDemoPassword123!
